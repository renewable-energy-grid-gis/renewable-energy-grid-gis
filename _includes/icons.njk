{% macro icon(name, color) %}
{% if name == 'sun' %}
<svg viewBox="0 0 24 24" class="icon icon--sun" aria-hidden="true">
  <circle cx="12" cy="12" r="4.2" fill="{{ color or '#F4A261' }}"/>
  <g stroke="{{ color or '#F4A261' }}" stroke-width="2" stroke-linecap="round" fill="none">
    <line x1="12" y1="2.5" x2="12" y2="5"/>
    <line x1="12" y1="19" x2="12" y2="21.5"/>
    <line x1="2.5" y1="12" x2="5" y2="12"/>
    <line x1="19" y1="12" x2="21.5" y2="12"/>
    <line x1="5.2" y1="5.2" x2="6.9" y2="6.9"/>
    <line x1="17.1" y1="17.1" x2="18.8" y2="18.8"/>
    <line x1="5.2" y1="18.8" x2="6.9" y2="17.1"/>
    <line x1="17.1" y1="6.9" x2="18.8" y2="5.2"/>
  </g>
</svg>
{% elif name == 'grid' %}
<svg viewBox="0 0 24 24" class="icon icon--grid" aria-hidden="true">
  <g stroke="{{ color or '#3D8B5F' }}" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3 L4 21 L20 21 Z"/>
    <line x1="6" y1="15" x2="18" y2="15"/>
    <line x1="8" y1="9" x2="16" y2="9"/>
  </g>
  <circle cx="12" cy="3" r="1.3" fill="{{ color or '#3D8B5F' }}"/>
</svg>
{% elif name == 'globe' %}
<svg viewBox="0 0 24 24" class="icon icon--globe" aria-hidden="true">
  <circle cx="12" cy="12" r="9" fill="none" stroke="{{ color or '#345B8B' }}" stroke-width="1.8"/>
  <ellipse cx="12" cy="12" rx="4" ry="9" fill="none" stroke="{{ color or '#345B8B' }}" stroke-width="1.6"/>
  <line x1="3" y1="12" x2="21" y2="12" stroke="{{ color or '#345B8B' }}" stroke-width="1.6"/>
  <line x1="12" y1="3" x2="12" y2="21" stroke="{{ color or '#345B8B' }}" stroke-width="1.6"/>
</svg>
{% elif name == 'home' %}
<svg viewBox="0 0 24 24" class="icon" aria-hidden="true">
  <path d="M3 11 L12 4 L21 11 V20 H14 V14 H10 V20 H3 Z" fill="none" stroke="{{ color or '#1F3A60' }}" stroke-width="1.8" stroke-linejoin="round"/>
</svg>
{% elif name == 'arrow' %}
<svg viewBox="0 0 24 24" class="icon" aria-hidden="true">
  <path d="M5 12 H19 M13 6 L19 12 L13 18" fill="none" stroke="{{ color or 'currentColor' }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{% elif name == 'menu' %}
<svg viewBox="0 0 24 24" class="icon" aria-hidden="true">
  <line x1="4" y1="7" x2="20" y2="7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <line x1="4" y1="12" x2="20" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <line x1="4" y1="17" x2="20" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
</svg>
{% elif name == 'close' %}
<svg viewBox="0 0 24 24" class="icon" aria-hidden="true">
  <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
</svg>
{% elif name == 'github' %}
<svg viewBox="0 0 24 24" class="icon icon--github" aria-hidden="true">
  <path fill="{{ color or 'currentColor' }}" fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z"/>
</svg>
{% endif %}
{% endmacro %}
