{% from "icons.njk" import icon %}
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="{{ site.url }}/" aria-label="{{ site.shortTitle }} — Home">
      <img src="/assets/logo-mark.svg" alt="" width="36" height="36" class="site-header__logo">
      <span class="site-header__brand-text">
        <span class="site-header__brand-1">Renewable Energy</span>
        <span class="site-header__brand-2">&amp; Grid GIS</span>
      </span>
    </a>
    <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false" aria-label="Switch to dark theme" title="Switch colour theme">
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
      </svg>
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/>
      </svg>
    </button>
    <button type="button" class="site-header__toggle" aria-controls="primary-nav" aria-expanded="false">
      {{ icon('menu') }}
      <span class="visually-hidden">Open menu</span>
    </button>
    <nav class="site-nav" id="primary-nav" aria-label="Primary">
      <ul class="site-nav__list">
        <li>
          <a href="{{ site.url }}/" class="site-nav__link {% if page.url == '/' %}is-active{% endif %}">
            {{ icon('home', '#1F3A60') }}<span>Home</span>
          </a>
        </li>
        {% for item in site.nav %}
          <li>
            <a href="{{ site.url }}{{ item.url }}" class="site-nav__link {% if page.url and page.url.startsWith(item.url) %}is-active{% endif %}">
              {{ icon(item.icon, item.color) }}<span>{{ item.label }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
